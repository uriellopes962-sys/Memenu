# Copia a .env.local para desarrollo local. En Vercel, agrega estas mismas
# claves en Project Settings → Environment Variables.

# Ya la tienes en Vercel (proyecto Supabase):
PUBLIC_SUPABASE_URL=

# Nueva: service_role key (secreta) — Supabase → Project Settings → API Keys
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier cadena larga y aleatoria, usada para firmar la sesión:
SESSION_SECRET=
